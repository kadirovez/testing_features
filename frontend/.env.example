# Base URL of the REST API. In dev the Vite proxy strips the /api prefix.
VITE_API_URL=/api
# WebSocket endpoint; relative paths are resolved against the current host.
VITE_WS_URL=/ws
# Backend address used by the Vite dev proxy.
VITE_PROXY_TARGET=http://localhost:8000
# Serve in-memory demo data instead of the real backend.
VITE_USE_MOCKS=false
