RATE_LIMIT_AUTH_PER_MINUTE=10
RATE_LIMIT_MEDIA_PER_MINUTE=30
RATE_LIMIT_WS_EVENTS_PER_SECOND=20

S3_ENDPOINT_URL=http://localhost:9000
S3_PUBLIC_ENDPOINT_URL=http://localhost:9000
